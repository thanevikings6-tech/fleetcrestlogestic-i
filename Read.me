background-position:center;
height:90vh;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}

.hero-content h1{
font-size:55px;
color:#D4AF37;
margin-bottom:15px;
}

.hero-content p{
font-size:20px;
margin-bottom:20px;
}

.btn{
background:#D4AF37;
color:#000;
padding:12px 25px;
text-decoration:none;
font-weight:bold;
border-radius:5px;
}

section{
padding:80px 20px;
max-width:1200px;
margin:auto;
}

.section-title{
text-align:center;
font-size:40px;
color:#D4AF37;
margin-bottom:40px;
}

.about{
text-align:center;
font-size:18px;
}

.plans{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.plan{
background:#111;
border:1px solid #D4AF37;
padding:25px;
border-radius:10px;
text-align:center;
}

.plan h3{
color:#D4AF37;
margin-bottom:10px;
}

.plan-price{
font-size:32px;
margin-bottom:10px;
font-weight:bold;
}

.features{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.feature{
background:#111;
padding:25px;
border-radius:10px;
text-align:center;
}

.feature h3{
color:#D4AF37;
margin-bottom:10px;
}

.contact{
text-align:center;
}

.contact a{
color:#D4AF37;
text-decoration:none;
}

footer{
background:#111;
text-align:center;
padding:30px;
}

@media(max-width:768px){
.hero-content h1{
font-size:36px;
}
nav{
flex-direction:column;
}
nav ul{
margin-top:10px;
}
}
